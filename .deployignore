# Files rsync must NOT publish to public_html (used by .github/workflows/ci.yml).
# Patterns follow rsync --exclude-from rules: a leading "/" anchors to the repo
# root; no slash matches at any depth; a trailing "/" matches directories.

# --- Version control / CI / tooling (never web-served) ---
/.git/
/.github/
/.gitignore
/.gitattributes
/.editorconfig
/.htmlvalidate.json
/.hintrc
/.vscode/
/.claude/
/node_modules/
/package.json
/package-lock.json
/ci/
/.deployignore

# --- Internal docs — don't publish (root-level only; chatbot/knowledge/*.md MUST deploy) ---
/README.md
/DEPLOY.md
/handoff.md
/TECHNICAL_OVERVIEW.md
/CHATBOT_SPEC.md
/cognify/README.md
/docs/
/scripts/README.md
/scripts/setup-instatic-prod.sh
/scripts/cloudflared-config-prod.yml

# --- DB schema is import-once, not web content ---
/db/

# Only reviewed knowledge is published, including when rsync runs locally.
# Keep this list aligned with CHATBOT_KNOWLEDGE_FILES in api/prompt.php.
+ /chatbot/knowledge/.htaccess
+ /chatbot/knowledge/00-org.md
+ /chatbot/knowledge/10-programs.md
+ /chatbot/knowledge/20-enrollment.md
+ /chatbot/knowledge/30-mentorship.md
+ /chatbot/knowledge/40-partnerships.md
+ /chatbot/knowledge/50-research-scholars.md
+ /chatbot/knowledge/90-faq.md
/chatbot/knowledge/*
.DS_Store

# --- Secrets: server-managed, also gitignored, never overwrite/remove ---
config.php

# --- Local source material, if ever present in the working tree ---
*Early Registration*.pdf
PageSpeed*.pdf
Website Grader*.pdf
