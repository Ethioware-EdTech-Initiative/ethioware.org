node_modules/
__pycache__/

# Backend DB credentials live in config.php (e.g. research-scholars/config.php).
# Never commit it — it holds the MySQL password. Matches config.php at any depth.
config.php

# SSH deploy keys & other private keys — generate OUTSIDE the repo, never commit.
ethioware_deploy
ethioware_deploy.pub
id_ed25519*
id_rsa*
*.pem

# Knowledge sources can contain minors' records and payment details.
# Only reviewed bot Markdown belongs in Git. Originals remain on disk.
.DS_Store
/chatbot/knowledge/*
!/chatbot/knowledge/.htaccess
!/chatbot/knowledge/.gitkeep
!/chatbot/knowledge/00-org.md
!/chatbot/knowledge/10-programs.md
!/chatbot/knowledge/20-enrollment.md
!/chatbot/knowledge/30-mentorship.md
